<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wordmemory.platform.mapper.LikeMapper">

    <insert id="insertLike" parameterType="com.wordmemory.platform.entity.Like"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO likes (from_user_id, to_user_id)
        VALUES (#{fromUserId}, #{toUserId})
    </insert>

    <select id="checkLike" resultType="com.wordmemory.platform.entity.Like">
        SELECT id, from_user_id, to_user_id, created_at
        FROM likes
        WHERE from_user_id = #{fromUserId} AND to_user_id = #{toUserId}
    </select>

    <select id="findLikedUserIds" resultType="java.lang.Integer">
        SELECT to_user_id
        FROM likes
        WHERE from_user_id = #{fromUserId}
    </select>

</mapper>
