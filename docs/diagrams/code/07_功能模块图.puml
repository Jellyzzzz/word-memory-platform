' 来源：《详细设计说明书》2.2.1 功能模块划分
@startuml 功能模块图
title 功能模块图
skinparam packageStyle rectangle

package "单词记忆与竞技学习平台" {
  folder "1. 用户模块" {
    [1.1 用户注册]
    [1.2 用户登录]
    [1.3 用户退出]
  }
  folder "2. 单词学习模块" {
    [2.1 学习模式（未掌握单词）]
    [2.2 复习模式（已掌握单词）]
    [2.3 熟练度管理（标记为不熟练）]
    folder "2.4 自定义单词管理" {
      [2.4.1 查看自定义单词]
      [2.4.2 CSV 导入单词]
      [2.4.3 删除自定义单词]
    }
  }
  folder "3. 排行榜模块" {
    [3.1 查看排行榜]
    [3.2 点赞]
  }
}
@enduml
